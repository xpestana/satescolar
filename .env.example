## ──────────────────────────────────────────────
## SAT Escolar – Variables de entorno para Docker
## ──────────────────────────────────────────────

# ─── PostgreSQL ───
# Usuario superusuario de la imagen supabase/postgres (no uses "postgres" con esta imagen)
POSTGRES_USER=supabase_admin
POSTGRES_PASSWORD=your-super-secret-password
POSTGRES_DB=postgres
POSTGRES_PORT=5432
# Evita en la contraseña caracteres que rompen URLs sin codificar: @ : / ? # & % + (p. ej. % al inicio)

# ─── JWT / API Keys ───
# Genera estas claves con: node scripts/generate-keys.js
JWT_SECRET=your-jwt-secret-at-least-32-characters-long
ANON_KEY=your-anon-key
SERVICE_ROLE_KEY=your-service-role-key

# ─── Supabase URLs (para el frontend) ───
VITE_SUPABASE_URL=http://localhost:8000
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-key
VITE_SUPABASE_PROJECT_ID=local

# URL pública de la API (navegador → gateway). Usado por Studio.
SUPABASE_PUBLIC_URL=http://localhost:8000

# ─── Supabase Studio + Postgres Meta (solo Docker) ───
# Puertos: app en :3000, Studio en puerto aparte para no pisar otros servicios
STUDIO_PORT=54321
# Nombres que ves en Studio (sidebar)
STUDIO_DEFAULT_ORGANIZATION=SAT Escolar
STUDIO_DEFAULT_PROJECT=local
# Clave para postgres-meta (genera una larga): openssl rand -base64 32
PG_META_CRYPTO_KEY=your-random-meta-crypto-at-least-32-chars-long
# Acceso a Studio: el navegador pedirá usuario/contraseña (HTTP Basic Auth)
STUDIO_AUTH_USER=admin
STUDIO_AUTH_PASSWORD=change-this-strong-password
# Enlazar Studio solo a esta interfaz (127.0.0.1 = solo tu PC; 0.0.0.0 = toda la LAN)
STUDIO_BIND=127.0.0.1
# Opcional: características IA en Studio
# OPENAI_API_KEY=

# ─── Supabase Auth (GoTrue) ───
GOTRUE_SITE_URL=http://localhost:3000
GOTRUE_URI_ALLOW_LIST=http://localhost:3000
GOTRUE_DISABLE_SIGNUP=false
GOTRUE_JWT_EXP=3600
GOTRUE_EXTERNAL_EMAIL_ENABLED=true
GOTRUE_MAILER_AUTOCONFIRM=false

# ─── SMTP (GoTrue emails + Edge Functions denomailer) ───
# Mailgun: servidor smtp.mailgun.org; suele usar puerto 587 (STARTTLS) o 465 (SSL implícito).
# Crea SMTP credentials en Mailgun → Sending → tu dominio → Domain settings → SMTP credentials.
# El usuario suele ser tipo postmaster@mg.tudominio.com (no el remitente "From").
# Si denomailer+Deno falla en STARTTLS (BadResource en startTls): usa SMTP_PORT=465 y SMTP_TLS_MODE=implicit,
# o deja SMTP_PORT=587: el código reintenta automáticamente en 465 con Mailgun.
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USER=postmaster@mg.tudominio.com
SMTP_PASS=tu-smtp-password-mailgun
SMTP_FROM_EMAIL=noreply@tudominio.com
SMTP_FROM_NAME=SAT Escolar
# Opcional: auto (defecto) | starttls | implicit | plain
# - auto: puerto 465 → SSL implícito; resto → STARTTLS (recomendado para 587/2525).
# - plain: sin cifrar (solo pruebas locales; no uses con Mailgun en producción).
SMTP_TLS_MODE=auto

# ─── AWS S3 (Edge Functions: s3-sign-upload, s3-migrate-existing) ───
# Credenciales IAM con permisos al bucket (PutObject, etc.)
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_REGION=us-east-1
AWS_S3_BUCKET=satescolar

# ─── Producción (solo para scripts de exportación) ───
SUPABASE_DB_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres
